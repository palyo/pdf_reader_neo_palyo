<?xml version="1.0" encoding="utf-8"?>
<!--
  Wrapper container that the inflated native ad layout (`ad_unified_banner`)
  is added into at runtime. Height changed from a fixed `native_65dp` to
  `wrap_content` with a `minHeight` floor: the inner layout now grows when
  the 3-line text stack needs more room (otherwise body text was clipped
  at the bottom of the row).
-->
<com.google.android.material.circularreveal.CircularRevealRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ad_native"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="1dp"
    android:minHeight="@dimen/native_65dp" />
