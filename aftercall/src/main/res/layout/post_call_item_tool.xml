<?xml version="1.0" encoding="utf-8"?>
<!--
  Tool tile for the after-call default tab.

  Three changes from the old design:
   1. The pink circle background that wrapped each icon has been removed —
      the icon now sits flat on the card, which made the visually-busy
      multi-colour icons (Word-to-PDF, Text-to-PDF) compete with the
      single-colour ones (Document Scanner).
   2. Icon canvas bumped from 28sdp → 32sdp now that there's no surrounding
      circle, and `scaleType="fitCenter"` is set explicitly so every asset
      renders at the same height regardless of source vector aspect ratio.
   3. The label uses `minLines="2"` + `maxLines="2"`, so even single-word
      labels reserve two lines of vertical space. That keeps every tile in
      the grid the same height — previously "Document Scanner" wrapped to
      two lines and grew taller than "Merge pdf" / "Split pdf", breaking
      the grid's visual rhythm.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/toolRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/_6sdp"
    android:background="@drawable/bg_after_call_card"
    android:clickable="true"
    android:elevation="@dimen/_1sdp"
    android:focusable="true"
    android:foreground="?selectableItemBackground"
    android:paddingHorizontal="@dimen/_12sdp"
    android:paddingVertical="@dimen/_16sdp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/toolIcon"
        android:layout_width="@dimen/_32sdp"
        android:layout_height="@dimen/_32sdp"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toTopOf="@+id/toolText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        tools:src="@drawable/ic_icon_tool_voice_changer" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/toolText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sdp"
        android:ellipsize="end"
        android:fontFamily="@font/medium"
        android:gravity="center"
        android:maxLines="2"
        android:minLines="2"
        android:textColor="@color/colorText"
        android:textSize="@dimen/_11ssp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolIcon"
        tools:text="Voice Changer" />
</androidx.constraintlayout.widget.ConstraintLayout>
